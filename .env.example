# HydraDB (local compose defaults)
HYDRADB_URL=http://127.0.0.1:8443
HYDRADB_BOLT_URL=bolt://127.0.0.1:7687
HYDRADB_AUTH_TOKEN=local-development-token-32-bytes
HYDRADB_GRAPH=default
HYDRADB_CELL=cell-0

# Planner LLM: LLM_PROVIDER = anthropic | groq | gemini | openai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=             # optional override (groq default llama-3.3-70b-versatile, gemini default gemini-3.5-flash-lite)
LLM_RPM=25             # client-side requests/minute cap for free tiers
PLANNER_MODEL=claude-haiku-5-5
# USD per million input tokens, for the cost-per-1k-tasks estimate
PRICE_PER_MTOK_INPUT=1.00

# Planner backend: llm (default; needs ANTHROPIC_API_KEY) or solver (LLM-free context-sufficiency planner)
PLANNER_BACKEND=llm
# Hosted app
RUN_RATE_LIMIT=10      # /api/run per client per minute
TRUST_PROXY=0          # 1 only behind your own edge proxy (e.g. Railway) so X-Forwarded-For is honoured
ADMIN_TOKEN=           # set to enable POST /api/demo/reset (Authorization: Bearer <token>)
