# HydraDB (local compose defaults)
HYDRADB_URL=http://127.0.0.1:8443
HYDRADB_BOLT_URL=bolt://127.0.0.1:7687
HYDRADB_AUTH_TOKEN=local-development-token-32-bytes
HYDRADB_GRAPH=default
HYDRADB_CELL=cell-0

# Planner LLM
ANTHROPIC_API_KEY=
PLANNER_MODEL=claude-haiku-5-5
# USD per million input tokens, for the cost-per-1k-tasks estimate
PRICE_PER_MTOK_INPUT=1.00
