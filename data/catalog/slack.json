[
 {
  "id": "tool:slack.find_channel",
  "server": "slack",
  "name": "find_channel",
  "description": "Find a Slack channel id by its name.",
  "input_schema": {
   "type": "object",
   "properties": {
    "channel_name": {
     "type": "string",
     "description": "Human-readable chat channel name such as #incidents"
    }
