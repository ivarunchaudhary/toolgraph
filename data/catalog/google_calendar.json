   "type:time_slot"
  ],
  "produces": [
   "type:event_updated"
  ],
  "capabilities": [
   "cap:calendar.event.update"
  ]
 },
 {
  "id": "tool:google_calendar.add_attendee",
  "server": "google_calendar",
  "name": "add_attendee",
