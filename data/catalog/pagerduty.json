[
 {
  "id": "tool:pagerduty.get_service",
  "server": "pagerduty",
  "name": "get_service",
  "description": "Get a PagerDuty service id by service name.",
  "input_schema": {
   "type": "object",
   "properties": {
    "service": {
     "type": "string",
     "description": "Name of a production service, e.g. payments-api"
    }
   },
   "required": [
    "service"
   ]
  },
  "consumes": [
   "type:service_name"
  ],
  "produces": [
   "type:pd_service_id"
  ],
  "capabilities": [
   "cap:incident.list",
   "cap:oncall.lookup"
  ]
 },
